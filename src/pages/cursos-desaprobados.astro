---
import MoodleLayout from '../layouts/Moodle-Layout.astro';
---

<MoodleLayout title="Cursos Desaprobados y Recuperatorios">
  <div class="space-y-8">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 no-print">
      <a href="/inicio" class="hover:text-blue-600 transition-colors flex items-center gap-1">
        <i class="fa-solid fa-house text-[10px]"></i>
        <span>Inicio</span>
      </a>
      <span>/</span>
      <span class="text-slate-700 font-bold">Cursos Desaprobados</span>
    </div>

    <!-- Banner Principal -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-900 to-rose-950 rounded-3xl p-8 text-white shadow-xl relative overflow-hidden">
      <div class="relative z-10 max-w-2xl">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 backdrop-blur-md mb-3 border border-rose-500/30">
          <i class="fa-solid fa-circle-exclamation text-rose-400"></i>
          Historial Académico • Instancias de Recuperación
        </span>
        <h1 class="text-3xl font-extrabold tracking-tight">Cursos No Aprobados</h1>
        <p class="text-slate-300 text-sm mt-2 leading-relaxed">
          En este apartado encontrarás el listado de asignaturas cuya cursada no alcanzó la nota mínima de aprobación (6.00). Podrás acceder a los contenidos de estudio, revisar trabajos prácticos y coordinar con tus profesores instancias de examen recuperatorio o regularización.
        </p>
      </div>
      <div class="absolute right-0 bottom-0 translate-x-8 translate-y-8 opacity-10 pointer-events-none text-white text-9xl">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
    </div>

    <!-- Tarjeta Resumen del Alumno -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-rose-500 to-slate-700 flex items-center justify-center text-white text-2xl font-black shadow-md shrink-0" id="resumen-alumno-iniciales">
          U
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-black text-slate-900" id="resumen-alumno-nombre">Cargando alumno...</h2>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-rose-50 text-rose-700 border border-rose-200">
              <i class="fa-solid fa-clock-rotate-left mr-1"></i>Seguimiento Académico
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">
            D.N.I.: <span class="font-mono font-bold text-slate-700" id="resumen-alumno-dni">---</span> • Escuela de Formación Profesional N° 31
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="px-4 py-2 bg-rose-50/50 border border-rose-200/80 rounded-2xl text-center">
          <span class="block text-[10px] font-bold text-rose-500 uppercase tracking-wider">Cursos No Aprobados</span>
          <span class="text-lg font-black text-rose-700" id="resumen-contador-desaprobados">0</span>
        </div>
      </div>
    </div>

    <!-- Listado de Cursos Desaprobados -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-black text-slate-900">Materias Pendientes de Acreditación</h2>
          <p class="text-xs text-slate-500">Haz clic en cada curso para consultar temarios, trabajos y foros de consulta docente</p>
        </div>
      </div>

      <div id="grid-cursos-desaprobados" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Tarjetas dinámicas generadas por JS -->
      </div>
    </div>
  </div>

  <script>
    import { api } from '../lib/api';
    import { getCurrentUser } from '../lib/auth';

    const user = getCurrentUser();

    const grid = document.getElementById('grid-cursos-desaprobados');
    const elNombreResumen = document.getElementById('resumen-alumno-nombre');
    const elDniResumen = document.getElementById('resumen-alumno-dni');
    const elIniciales = document.getElementById('resumen-alumno-iniciales');
    const elContador = document.getElementById('resumen-contador-desaprobados');

    function formatearNotaLetras(nota: number | string): string {
      const num = Number(nota);
      if (isNaN(num)) return String(nota);
      const nombres: Record<number, string> = {
        0: 'cero', 1: 'uno', 2: 'dos', 3: 'tres', 4: 'cuatro',
        5: 'cinco', 6: 'seis', 7: 'siete', 8: 'ocho', 9: 'nueve', 10: 'diez'
      };
      const esEntero = Number.isInteger(num) || num % 1 === 0;
      if (esEntero) {
        const entero = Math.round(num);
        const textoEntero = nombres[entero] || `${entero}`;
        return `${entero}(${textoEntero})`;
      }

      const parteEntera = Math.floor(num);
      const decimal = Math.round((num - parteEntera) * 10);
      const textoEntero = nombres[parteEntera] || `${parteEntera}`;
      const textoDecimal = nombres[decimal] || `${decimal}`;
      const notaFmt = num.toFixed(1);
      return `${notaFmt}(${textoEntero} con ${textoDecimal})`;
    }

    async function cargarCursosDesaprobados() {
      if (!grid) return;

      if (!user) {
        grid.innerHTML = `
          <div class="col-span-full bg-white p-8 rounded-3xl border border-slate-200 text-center text-slate-500">
            <p class="font-bold text-slate-700">Debes iniciar sesión para consultar tu historial académico.</p>
            <a href="/" class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-xs font-bold rounded-xl">Iniciar Sesión</a>
          </div>
        `;
        return;
      }

      const nombreCompleto = `${user.nombre || ''} ${user.apellido || ''}`.trim() || 'Estudiante';
      if (elNombreResumen) elNombreResumen.textContent = nombreCompleto;
      if (elDniResumen) elDniResumen.textContent = String(user.dni || '---');
      if (elIniciales) {
        const init1 = (user.nombre || 'U')[0].toUpperCase();
        const init2 = (user.apellido || '')[0]?.toUpperCase() || '';
        elIniciales.textContent = `${init1}${init2}`;
      }

      grid.innerHTML = `
        <div class="col-span-full p-12 text-center text-slate-400">
          <i class="fa-solid fa-spinner fa-spin text-3xl mb-3 text-rose-500"></i>
          <p class="text-sm font-medium">Buscando cursos no aprobados...</p>
        </div>
      `;

      try {
        const desaprobados = await api.curso.cursosDesaprobadosPorAlumno(user.id);
        const listaCursos = Array.isArray(desaprobados) ? desaprobados : [];

        if (elContador) elContador.textContent = String(listaCursos.length);

        if (listaCursos.length === 0) {
          grid.innerHTML = `
            <div class="col-span-full bg-white p-10 rounded-3xl border border-slate-200 text-center space-y-4 shadow-sm">
              <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-3xl mx-auto shadow-sm">
                <i class="fa-solid fa-circle-check"></i>
              </div>
              <div class="max-w-md mx-auto">
                <h3 class="text-lg font-black text-slate-900">¡Excelente desempeño!</h3>
                <p class="text-xs text-slate-500 mt-1 leading-relaxed">
                  No registras cursos ni asignaturas desaprobadas. Tu trayectoria académica se encuentra al día y sin materias pendientes de recuperación.
                </p>
              </div>
              <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
                <a href="/inicio" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-md transition-all">
                  <i class="fa-solid fa-book-open"></i>
                  <span>Ir a Mis Cursos Activos</span>
                </a>
                <a href="/cursos-aprobados" class="inline-flex items-center gap-2 px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-xl shadow-md transition-all">
                  <i class="fa-solid fa-award"></i>
                  <span>Ver Cursos Aprobados</span>
                </a>
              </div>
            </div>
          `;
          return;
        }

        grid.innerHTML = listaCursos.map((c) => {
          const notaNum = c.nota !== null && c.nota !== undefined ? Number(c.nota) : null;
          const anio = c.anio || new Date().getFullYear();
          const profesor = c.profesor || 'Cuerpo Docente';

          return `
            <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="p-6 bg-gradient-to-r from-rose-600 via-rose-700 to-slate-800 text-white relative overflow-hidden">
                  <div class="flex items-center justify-between mb-2 relative z-10">
                    <span class="px-2.5 py-0.5 rounded-full bg-white/20 text-white text-[10px] font-black uppercase tracking-wider backdrop-blur-md">
                      <i class="fa-solid fa-triangle-exclamation mr-1"></i>No Aprobado
                    </span>
                    <span class="text-xs font-bold text-rose-100">
                      Ciclo ${anio}
                    </span>
                  </div>
                  <h3 class="text-xl font-black leading-snug drop-shadow-sm relative z-10">${c.nombre}</h3>
                  <div class="absolute -right-4 -bottom-4 text-white/10 text-8xl pointer-events-none">
                    <i class="fa-solid fa-circle-xmark"></i>
                  </div>
                </div>

                <div class="p-6 space-y-4">
                  <p class="text-xs text-slate-500 leading-relaxed line-clamp-2">
                    ${c.descripcion || 'Asignatura con contenidos teóricos y prácticos de formación técnica.'}
                  </p>

                  <div class="space-y-2 border-t border-slate-100 pt-3">
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-slate-400 font-medium">Calificación Registrada:</span>
                      <span class="font-extrabold text-rose-700 bg-rose-50 px-2.5 py-0.5 rounded-lg border border-rose-200">
                        ${notaNum !== null ? formatearNotaLetras(notaNum) : 'Sin calificar (< 6)'}
                      </span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-slate-400 font-medium">Profesor a Cargo:</span>
                      <span class="font-bold text-slate-700 truncate max-w-[180px]" title="${profesor}">
                        ${profesor}
                      </span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-slate-400 font-medium">Condición Actual:</span>
                      <span class="font-bold text-amber-600 flex items-center gap-1">
                        <i class="fa-solid fa-rotate text-[10px]"></i> Instancia Recuperatoria
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="p-6 pt-0 space-y-2">
                <a
                  href="/curso-detalle?id=${c.id}"
                  class="w-full py-2.5 px-4 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
                >
                  <i class="fa-solid fa-book-open text-blue-400"></i>
                  <span>Ver Contenidos y Materiales</span>
                </a>
                <a
                  href="/foro?curso_id=${c.id}"
                  class="w-full py-2 px-4 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs rounded-xl border border-rose-200/80 transition-all flex items-center justify-center gap-2 cursor-pointer"
                >
                  <i class="fa-solid fa-comments text-rose-500"></i>
                  <span>Consultar en el Foro Docente</span>
                </a>
              </div>
            </div>
          `;
        }).join('');

      } catch (err: any) {
        console.error('Error al cargar cursos desaprobados:', err);
        grid.innerHTML = `<div class="col-span-full p-8 text-center text-red-500">Error al consultar el historial: ${err.message}</div>`;
      }
    }

    cargarCursosDesaprobados();
  </script>
</MoodleLayout>
