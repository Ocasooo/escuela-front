---
import DashboardLayout from '../layouts/Dashboard-Layout.astro';
---

<DashboardLayout title="Notas de Cursado" path="desempeno" pageTitle="Registro de Calificaciones Finales y Cursado">
  <div class="space-y-6">
    <!-- Barra de Selección, Modo y Búsqueda -->
    <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex flex-col xl:flex-row xl:items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-4">
        <!-- Materia / Comisión -->
        <div>
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Materia / Comisión</label>
          <select id="select-materia" class="px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800 outline-none focus:ring-2 focus:ring-blue-100">
            <option value="">Cargando materias asignadas...</option>
          </select>
        </div>

        <!-- Selector de Año (Visible en modo edición de historial) -->
        <div id="container-select-anio" class="hidden">
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Año de Cursado</label>
          <select id="select-anio" class="px-3 py-2 text-xs bg-amber-50 border border-amber-200 rounded-xl font-bold text-amber-900 outline-none focus:ring-2 focus:ring-amber-100">
            <!-- Opciones dinámicas de años -->
          </select>
        </div>

        <!-- Buscador de Estudiantes -->
        <div class="w-full sm:w-64">
          <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Buscar Estudiante</label>
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-2.5 text-slate-400 text-xs"></i>
            <input
              type="text"
              id="input-buscar-alumno"
              placeholder="Buscar por nombre, apellido o DNI..."
              class="w-full pl-9 pr-4 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:bg-white focus:border-blue-600 focus:ring-2 focus:ring-blue-100 transition-all font-medium text-slate-700"
            />
          </div>
        </div>
      </div>

      <!-- Botones de Acción -->
      <div class="flex flex-wrap items-center gap-3">
        <!-- Botón para alternar a Historial / Editar Notas -->
        <button
          type="button"
          id="btn-toggle-modo"
          class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition-all flex items-center gap-2 shadow-2xs"
        >
          <i id="icono-toggle-modo" class="fa-solid fa-clock-rotate-left"></i>
          <span id="texto-toggle-modo">Editar Notas Registradas</span>
        </button>

        <!-- Botón Principal: Cargar Cursado o Guardar Cambios según el modo -->
        <button
          type="button"
          id="btn-accion-principal"
          class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center gap-2"
        >
          <i id="icono-accion-principal" class="fa-solid fa-check-circle"></i>
          <span id="texto-accion-principal">Registrar notas del cursado</span>
        </button>
      </div>
    </div>

    <!-- Banner explicativo del Modo Actual -->
    <div id="banner-modo" class="p-3 px-5 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-between text-xs text-blue-800">
      <div class="flex items-center gap-2.5">
        <i id="banner-icono" class="fa-solid fa-circle-info text-blue-600"></i>
        <span id="banner-texto" class="font-semibold">
          Mostrando estudiantes actualmente <strong>cursando</strong> en el ciclo actual. Ingrese sus calificaciones finales y presione <strong>"Registrar notas del cursado"</strong>.
        </span>
      </div>
      <span id="banner-badge" class="px-2.5 py-0.5 rounded-full text-[11px] font-black bg-blue-200/70 text-blue-900 uppercase tracking-wide">
        Modo Carga
      </span>
    </div>

    <!-- Tabla de Calificaciones de Cursado -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 uppercase font-bold tracking-wider border-b border-slate-200">
            <tr>
              <th class="p-4">DNI</th>
              <th class="p-4">Estudiante</th>
              <th class="p-4 text-center">Año Cursado</th>
              <th class="p-4 text-center">Promedio TPs</th>
              <th class="p-4 text-center">Nota Cursado</th>
              <th class="p-4 text-center">Condición Final</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="alumnos-cursado-body">
            <!-- Filas dinámicas generadas por JS -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal de Éxito de Notas Guardadas -->
  <div id="modal-exito-notas" class="fixed inset-0 bg-slate-900/60 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 md:p-8 shadow-2xl border border-slate-100 animate-fadeIn text-center space-y-5">
      <div class="w-14 h-14 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto text-2xl">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      
      <div class="space-y-1">
        <h3 id="modal-exito-titulo" class="text-lg font-black text-slate-900">¡Notas Registradas!</h3>
        <p id="modal-exito-mensaje" class="text-xs text-slate-500">
          Las notas de cursado fueron guardadas exitosamente. Los alumnos calificados ahora están aprobados o desaprobados.
        </p>
      </div>

      <button type="button" id="btn-cerrar-exito-notas" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-md transition-all cursor-pointer">
        Aceptar
      </button>
    </div>
  </div>

  <!-- Modal de Advertencia / Información de Desempeño -->
  <div id="modal-alerta-desempeno" class="fixed inset-0 bg-slate-900/60 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 md:p-8 shadow-2xl border border-slate-100 animate-fadeIn text-center space-y-5">
      <div id="modal-alerta-icono-wrap" class="w-16 h-16 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center mx-auto text-3xl border border-amber-100 shadow-inner">
        <i id="modal-alerta-icono" class="fa-solid fa-triangle-exclamation"></i>
      </div>
      
      <div class="space-y-1.5">
        <h3 id="modal-alerta-titulo" class="text-lg font-black text-slate-900">Atención</h3>
        <p id="modal-alerta-mensaje" class="text-xs text-slate-500 leading-relaxed">
          Mensaje de advertencia
        </p>
      </div>

      <button
        type="button"
        id="btn-cerrar-alerta-desempeno"
        class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs rounded-xl shadow-md transition-all cursor-pointer"
      >
        Entendido
      </button>
    </div>
  </div>

  <script>
    import { api } from '../lib/api';
    import { getCurrentUser } from '../lib/auth';

    interface AlumnoCursado {
      id: number;
      dni: string;
      nombre: string;
      apellido: string;
      anio: number;
      estado_terminacion: string;
      promedio_tp: number;
      nota_parcial: number;
      asistencia: number;
      nota_final: number | null;
      nota_ingresada: string;
    }

    // Estado de la pantalla
    let modoActual: 'carga' | 'edicion' = 'carga';
    let anioActual = new Date().getFullYear();
    let anioSeleccionado = anioActual;
    let alumnosTodos: AlumnoCursado[] = [];

    const selectMateria = document.getElementById('select-materia') as HTMLSelectElement;
    const selectAnio = document.getElementById('select-anio') as HTMLSelectElement;
    const containerSelectAnio = document.getElementById('container-select-anio');
    const inputBuscar = document.getElementById('input-buscar-alumno') as HTMLInputElement;
    const tbody = document.getElementById('alumnos-cursado-body');
    const btnToggleModo = document.getElementById('btn-toggle-modo');
    const iconoToggleModo = document.getElementById('icono-toggle-modo');
    const textoToggleModo = document.getElementById('texto-toggle-modo');
    const btnAccionPrincipal = document.getElementById('btn-accion-principal') as HTMLButtonElement;
    const iconoAccionPrincipal = document.getElementById('icono-accion-principal');
    const textoAccionPrincipal = document.getElementById('texto-accion-principal');
    const bannerModo = document.getElementById('banner-modo');
    const bannerIcono = document.getElementById('banner-icono');
    const bannerTexto = document.getElementById('banner-texto');
    const bannerBadge = document.getElementById('banner-badge');
    const modalExito = document.getElementById('modal-exito-notas');
    const modalExitoTitulo = document.getElementById('modal-exito-titulo');
    const modalExitoMensaje = document.getElementById('modal-exito-mensaje');

    const modalAlerta = document.getElementById('modal-alerta-desempeno');
    const modalAlertaTitulo = document.getElementById('modal-alerta-titulo');
    const modalAlertaMensaje = document.getElementById('modal-alerta-mensaje');
    const modalAlertaIcono = document.getElementById('modal-alerta-icono');
    const modalAlertaIconoWrap = document.getElementById('modal-alerta-icono-wrap');
    const btnCerrarAlerta = document.getElementById('btn-cerrar-alerta-desempeno');

    function mostrarAlerta(titulo: string, mensaje: string, tipo: 'warning' | 'error' = 'warning') {
      if (modalAlertaTitulo) modalAlertaTitulo.textContent = titulo;
      if (modalAlertaMensaje) modalAlertaMensaje.textContent = mensaje;

      if (tipo === 'error') {
        if (modalAlertaIconoWrap) modalAlertaIconoWrap.className = 'w-16 h-16 bg-rose-50 text-rose-600 rounded-2xl flex items-center justify-center mx-auto text-3xl border border-rose-100 shadow-inner';
        if (modalAlertaIcono) modalAlertaIcono.className = 'fa-solid fa-circle-xmark';
        if (btnCerrarAlerta) btnCerrarAlerta.className = 'w-full py-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl shadow-md transition-all cursor-pointer';
      } else {
        if (modalAlertaIconoWrap) modalAlertaIconoWrap.className = 'w-16 h-16 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center mx-auto text-3xl border border-amber-100 shadow-inner';
        if (modalAlertaIcono) modalAlertaIcono.className = 'fa-solid fa-triangle-exclamation';
        if (btnCerrarAlerta) btnCerrarAlerta.className = 'w-full py-3 bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs rounded-xl shadow-md transition-all cursor-pointer';
      }

      modalAlerta?.classList.remove('hidden');
    }

    btnCerrarAlerta?.addEventListener('click', () => {
      modalAlerta?.classList.add('hidden');
    });

    modalAlerta?.addEventListener('click', (e) => {
      if (e.target === modalAlerta) {
        modalAlerta.classList.add('hidden');
      }
    });

    modalExito?.addEventListener('click', (e) => {
      if (e.target === modalExito) {
        modalExito.classList.add('hidden');
      }
    });

    async function inicializarMaterias() {
      try {
        const user = getCurrentUser();
        let cursos: any[] = [];
        if (user?.id) {
          cursos = await api.curso.cursosPorPersonal(user.id).catch(() => []);
        } else {
          cursos = await api.curso.todos().catch(() => []);
        }

        if (selectMateria) {
          if (cursos && cursos.length > 0) {
            selectMateria.innerHTML = cursos.map((c: any) => 
              `<option value="${c.id}">${c.nombre}</option>`
            ).join('');
            await cargarAlumnos();
          } else {
            selectMateria.innerHTML = '<option value="">No tienes materias asignadas</option>';
            alumnosTodos = [];
            renderTabla();
          }
        }
      } catch (err) {
        console.error('Error al inicializar materias:', err);
      }
    }

    async function cargarAlumnos() {
      const cursoId = selectMateria?.value;
      if (!cursoId) {
        alumnosTodos = [];
        renderTabla();
        return;
      }

      try {
        const rows = await api.curso.obtenerNotasPorCurso(cursoId);
        if (rows && Array.isArray(rows)) {
          alumnosTodos = rows.map((r: any) => {
            let notaVal: number | null = null;
            if (r.nota !== null && r.nota !== undefined && r.nota !== '' && String(r.nota).trim() !== '----') {
              const num = parseFloat(String(r.nota));
              if (!isNaN(num)) {
                notaVal = parseFloat(num.toFixed(1));
              }
            }
            return {
              id: r.id || r.alumno_id,
              dni: String(r.dni || '---'),
              nombre: r.nombre || '',
              apellido: r.apellido || '',
              anio: Number(r.anio) || anioActual,
              estado_terminacion: (r.estado_terminacion || 'cursando').toLowerCase(),
              promedio_tp: r.promedio_tp ? Number(r.promedio_tp) : 8.0,
              nota_parcial: r.nota_parcial ? Number(r.nota_parcial) : 8.0,
              asistencia: r.asistencia ? Number(r.asistencia) : 90,
              nota_final: notaVal,
              nota_ingresada: ''
            };
          });

          actualizarSelectorAnios();
        } else {
          alumnosTodos = [];
        }
      } catch (err) {
        console.error('Error al cargar notas de cursado:', err);
        alumnosTodos = [];
      }
      renderTabla();
    }

    function actualizarSelectorAnios() {
      if (!selectAnio) return;
      const aniosSet = new Set<number>();
      aniosSet.add(anioActual);
      alumnosTodos.forEach((a) => {
        if (a.anio) aniosSet.add(Number(a.anio));
      });
      const listaAnios = Array.from(aniosSet).sort((a, b) => b - a);
      
      selectAnio.innerHTML = listaAnios.map((anio) => 
        `<option value="${anio}" ${anio === anioSeleccionado ? 'selected' : ''}>Ciclo ${anio}</option>`
      ).join('');
    }

    function renderTabla() {
      if (!tbody) return;

      const termino = inputBuscar?.value.toLowerCase().trim() || '';

      // Filtrar según el modo activo
      let listaFiltrada: AlumnoCursado[] = [];

      if (modoActual === 'carga') {
        // Modo Carga: Solo inscriptos al ciclo actual que sigan en 'cursando'
        listaFiltrada = alumnosTodos.filter((a) => {
          const esAnioActual = a.anio === anioActual;
          const estaCursando = a.estado_terminacion === 'cursando';
          return esAnioActual && estaCursando;
        });
      } else {
        // Modo Edición: Todos los estudiantes del año seleccionado (aprobados, desaprobados o cursando)
        listaFiltrada = alumnosTodos.filter((a) => a.anio === anioSeleccionado);
      }

      // Filtro de búsqueda por texto o DNI
      if (termino) {
        listaFiltrada = listaFiltrada.filter((a) => {
          const matchNombre = `${a.nombre} ${a.apellido}`.toLowerCase().includes(termino);
          const matchDni = a.dni.includes(termino);
          return matchNombre || matchDni;
        });
      }

      // Caso de lista vacía
      if (listaFiltrada.length === 0) {
        if (modoActual === 'carga') {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="p-12 text-center">
                <div class="max-w-md mx-auto space-y-3">
                  <div class="w-14 h-14 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mx-auto text-xl shadow-xs">
                    <i class="fa-solid fa-circle-check"></i>
                  </div>
                  <h4 class="text-sm font-bold text-slate-800">¡No hay estudiantes pendientes de calificar!</h4>
                  <p class="text-xs text-slate-500 leading-relaxed">
                    Todos los alumnos inscriptos al ciclo ${anioActual} ya tienen sus notas de cursado registradas (están aprobados o desaprobados).
                  </p>
                  <button type="button" id="btn-ir-a-editar" class="mt-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition-all inline-flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Ver o editar notas registradas</span>
                  </button>
                </div>
              </td>
            </tr>
          `;
          document.getElementById('btn-ir-a-editar')?.addEventListener('click', alternarModo);
        } else {
          tbody.innerHTML = `
            <tr>
              <td colspan="6" class="p-8 text-center text-slate-400">
                No se encontraron registros de estudiantes para el ciclo ${anioSeleccionado}.
              </td>
            </tr>
          `;
        }
        return;
      }

      // Renderizar filas
      tbody.innerHTML = listaFiltrada.map((a) => {
        let valorInput = '';
        let estadoBadge = '';

        if (modoActual === 'carga') {
          // En modo carga: el input aparece vacío por defecto para que el profesor ingrese la nota
          valorInput = a.nota_ingresada !== '' ? a.nota_ingresada : '';
          if (valorInput !== '') {
            const notaNum = Number(valorInput);
            const aprobado = notaNum >= 6;
            estadoBadge = `
              <span class="px-2.5 py-1 rounded-full text-xs font-extrabold ${aprobado ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700'}">
                ${aprobado ? 'Aprobado' : 'Desaprobado'}
              </span>
            `;
          } else {
            estadoBadge = `
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-400">
                Pendiente
              </span>
            `;
          }
        } else {
          // En modo edición: el input muestra la nota guardada (o la editada)
          const notaGuardada = a.nota_ingresada !== '' ? a.nota_ingresada : (a.nota_final !== null ? String(a.nota_final) : '');
          valorInput = notaGuardada;
          if (valorInput !== '') {
            const notaNum = Number(valorInput);
            const aprobado = notaNum >= 6;
            estadoBadge = `
              <span class="px-2.5 py-1 rounded-full text-xs font-extrabold ${aprobado ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700'}">
                ${aprobado ? 'Aprobado' : 'Desaprobado'}
              </span>
            `;
          } else {
            const aprobado = a.estado_terminacion === 'aprobado' || a.estado_terminacion === 'egresado';
            const desaprobado = a.estado_terminacion === 'desaprobado';
            if (aprobado) {
              estadoBadge = `<span class="px-2.5 py-1 rounded-full text-xs font-extrabold bg-emerald-50 text-emerald-700">Aprobado</span>`;
            } else if (desaprobado) {
              estadoBadge = `<span class="px-2.5 py-1 rounded-full text-xs font-extrabold bg-red-50 text-red-700">Desaprobado</span>`;
            } else {
              estadoBadge = `<span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500">Cursando</span>`;
            }
          }
        }

        return `
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-4 font-mono text-slate-500 font-semibold">${a.dni}</td>
            <td class="p-4 font-bold text-slate-900">${a.apellido}, ${a.nombre}</td>
            <td class="p-4 text-center font-bold text-slate-600">${a.anio}</td>
            <td class="p-4 text-center font-semibold text-slate-700">${a.promedio_tp.toFixed(1)}</td>
            <td class="p-4 text-center">
              <input
                type="text"
                inputmode="decimal"
                value="${valorInput}"
                data-id="${a.id}"
                placeholder="${modoActual === 'carga' ? 'Ej: 8.5' : '0-10'}"
                class="input-nota-cursado w-16 text-center font-black text-slate-900 bg-white border border-slate-300 rounded-lg py-1.5 px-2 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100 transition-all shadow-2xs"
              />
            </td>
            <td class="p-4 text-center" id="condicion-alumno-${a.id}">
              ${estadoBadge}
            </td>
          </tr>
        `;
      }).join('');

      // Eventos para validar números y actualizar condición en tiempo real
      document.querySelectorAll('.input-nota-cursado').forEach((inp) => {
        const input = inp as HTMLInputElement;

        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          target.value = target.value.replace(/,/g, '.').replace(/[^0-9.]/g, '');
          const partes = target.value.split('.');
          if (partes.length > 2) {
            target.value = partes[0] + '.' + partes.slice(1).join('');
          }
          if (partes.length === 2 && partes[1].length > 1) {
            target.value = partes[0] + '.' + partes[1].slice(0, 1);
          }
          if (target.value !== '' && Number(target.value) > 10) {
            target.value = '10';
          }
          actualizarFilaCondicion(Number(target.getAttribute('data-id')), target.value);
        });

        input.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          const id = Number(target.getAttribute('data-id'));
          let val = target.value.replace(/,/g, '.').trim();
          if (val !== '') {
            let num = parseFloat(val);
            if (isNaN(num) || num < 0) num = 0;
            if (num > 10) num = 10;
            const formateado = num % 1 === 0 ? String(num) : num.toFixed(1);
            target.value = formateado;
            val = formateado;
          }
          actualizarFilaCondicion(id, val);
        });
      });
    }

    function actualizarFilaCondicion(id: number, valor: string) {
      const alumno = alumnosTodos.find((a) => a.id === id);
      if (alumno) {
        alumno.nota_ingresada = valor;
      }
      const tdCondicion = document.getElementById(`condicion-alumno-${id}`);
      if (!tdCondicion) return;

      if (valor !== '') {
        const nota = Number(valor);
        const aprobado = nota >= 6;
        tdCondicion.innerHTML = `
          <span class="px-2.5 py-1 rounded-full text-xs font-extrabold ${aprobado ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700'}">
            ${aprobado ? 'Aprobado' : 'Desaprobado'}
          </span>
        `;
      } else {
        if (modoActual === 'carga') {
          tdCondicion.innerHTML = `
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-400">
              Pendiente
            </span>
          `;
        } else {
          tdCondicion.innerHTML = `
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500">
              Sin Nota
            </span>
          `;
        }
      }
    }

    function alternarModo() {
      if (modoActual === 'carga') {
        modoActual = 'edicion';
        containerSelectAnio?.classList.remove('hidden');

        if (textoToggleModo) textoToggleModo.textContent = 'Cargar Cursado Actual';
        if (iconoToggleModo) iconoToggleModo.className = 'fa-solid fa-arrow-left';

        if (textoAccionPrincipal) textoAccionPrincipal.textContent = 'Guardar Cambios';
        if (iconoAccionPrincipal) iconoAccionPrincipal.className = 'fa-solid fa-floppy-disk';
        btnAccionPrincipal.className = 'px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center gap-2';

        if (bannerModo) bannerModo.className = 'p-3 px-5 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-between text-xs text-amber-900';
        if (bannerIcono) bannerIcono.className = 'fa-solid fa-pen-to-square text-amber-600';
        if (bannerTexto) bannerTexto.innerHTML = 'Mostrando <strong>todos los estudiantes</strong> del ciclo seleccionado. Puede modificar y corregir las notas registradas.';
        if (bannerBadge) {
          bannerBadge.textContent = 'Modo Edición';
          bannerBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-black bg-amber-200/70 text-amber-900 uppercase tracking-wide';
        }
      } else {
        modoActual = 'carga';
        containerSelectAnio?.classList.add('hidden');

        if (textoToggleModo) textoToggleModo.textContent = 'Editar Notas Registradas';
        if (iconoToggleModo) iconoToggleModo.className = 'fa-solid fa-clock-rotate-left';

        if (textoAccionPrincipal) textoAccionPrincipal.textContent = 'Registrar notas del cursado';
        if (iconoAccionPrincipal) iconoAccionPrincipal.className = 'fa-solid fa-check-circle';
        btnAccionPrincipal.className = 'px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center gap-2';

        if (bannerModo) bannerModo.className = 'p-3 px-5 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-between text-xs text-blue-800';
        if (bannerIcono) bannerIcono.className = 'fa-solid fa-circle-info text-blue-600';
        if (bannerTexto) bannerTexto.innerHTML = 'Mostrando estudiantes actualmente <strong>cursando</strong> en el ciclo actual. Ingrese sus calificaciones finales y presione <strong>"Registrar notas del cursado"</strong>.';
        if (bannerBadge) {
          bannerBadge.textContent = 'Modo Carga';
          bannerBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-black bg-blue-200/70 text-blue-900 uppercase tracking-wide';
        }
      }

      renderTabla();
    }

    btnToggleModo?.addEventListener('click', alternarModo);

    selectAnio?.addEventListener('change', () => {
      anioSeleccionado = Number(selectAnio.value) || anioActual;
      renderTabla();
    });

    // Acción del botón principal (Registrar notas de cursado / Guardar cambios)
    btnAccionPrincipal?.addEventListener('click', async () => {
      const cursoId = Number(selectMateria?.value);
      if (!cursoId) {
        mostrarAlerta('Materia Requerida', 'Por favor, seleccione una materia o comisión válida antes de continuar.');
        return;
      }

      // Recolectar notas escritas
      const notasAEnviar: { alumnoId: number; nota: number; cursoId: number; anio: number }[] = [];

      document.querySelectorAll('.input-nota-cursado').forEach((inp) => {
        const target = inp as HTMLInputElement;
        const id = Number(target.getAttribute('data-id'));
        const val = target.value.trim();

        if (val !== '') {
          let num = parseFloat(val);
          if (!isNaN(num)) {
            if (num < 0) num = 0;
            if (num > 10) num = 10;
            num = parseFloat(num.toFixed(1));
            const alu = alumnosTodos.find((a) => a.id === id);
            const anioNota = alu ? alu.anio : (modoActual === 'carga' ? anioActual : anioSeleccionado);
            notasAEnviar.push({
              alumnoId: id,
              nota: num,
              cursoId,
              anio: anioNota
            });
          }
        }
      });

      if (notasAEnviar.length === 0) {
        mostrarAlerta(
          'Sin notas para guardar',
          modoActual === 'carga'
            ? 'Por favor, ingresa la calificación de al menos un estudiante antes de registrar las notas del cursado.'
            : 'No hay notas ingresadas o modificadas para guardar en este ciclo lectivo.'
        );
        return;
      }

      const textoOriginal = btnAccionPrincipal.innerHTML;
      try {
        btnAccionPrincipal.disabled = true;
        btnAccionPrincipal.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Guardando...`;

        // Enviar lote al backend
        await api.curso.cargarNotaCursado({
          cursoId,
          notas: notasAEnviar
        });

        // Configurar mensaje de éxito en modal
        if (modalExitoTitulo) {
          modalExitoTitulo.textContent = modoActual === 'carga' ? '¡Notas de Cursado Registradas!' : '¡Notas Actualizadas!';
        }
        if (modalExitoMensaje) {
          modalExitoMensaje.textContent = modoActual === 'carga'
            ? 'Los estudiantes calificados han sido registrados exitosamente como aprobados o desaprobados y ya no figuran como cursando.'
            : 'Las calificaciones del ciclo lectivo seleccionado se actualizaron correctamente en la base de datos.';
        }

        // Recargar datos desde la base de datos
        await cargarAlumnos();

        modalExito?.classList.remove('hidden');
      } catch (err: any) {
        console.error('Error al guardar notas de cursado:', err);
        mostrarAlerta('Error al guardar', 'Ocurrió un error al guardar las notas: ' + (err.message || 'Error del servidor'), 'error');
      } finally {
        btnAccionPrincipal.disabled = false;
        btnAccionPrincipal.innerHTML = textoOriginal;
      }
    });

    document.getElementById('btn-cerrar-exito-notas')?.addEventListener('click', () => {
      modalExito?.classList.add('hidden');
    });

    inputBuscar?.addEventListener('input', renderTabla);
    selectMateria?.addEventListener('change', cargarAlumnos);
    inicializarMaterias();
  </script>
</DashboardLayout>