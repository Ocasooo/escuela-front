    const visorImgSrc = document.getElementById('visor-img-src') as HTMLImageElement;
    const btnCerrarVisorImg = document.getElementById('btn-cerrar-visor-img');

    function abrirVisorImagen(src: string, titulo?: string) {
      if (visorImgSrc) visorImgSrc.src = src;
      if (visorImgTitulo) visorImgTitulo.textContent = titulo || 'Imagen Didáctica';
      modalVisorImg?.classList.remove('hidden');
