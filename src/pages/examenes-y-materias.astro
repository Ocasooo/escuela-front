      modalCrearTP?.classList.remove('hidden');
    }

    const cerrarModalCrearTP = () => modalCrearTP?.classList.add('hidden');
    document.getElementById('btn-cerrar-modal-crear-tp')?.addEventListener('click', cerrarModalCrearTP);
    document.getElementById('btn-cancelar-crear-tp')?.addEventListener('click', cerrarModalCrearTP);

    document.getElementById('form-crear-tp')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentCursoId) return;

      const unidadId = tpSelectUnidad?.value;
      if (!unidadId) {
        alert('Debe seleccionar una unidad para este trabajo práctico.');
        return;
      }

      if (!tpFile.files || tpFile.files.length === 0) {
        alert('Seleccione un archivo de consigna/enunciado.');
        return;
      }

      const fechaLimInput = document.getElementById('tp-fecha-limite') as HTMLInputElement;
      const horaLimInput = document.getElementById('tp-hora-limite') as HTMLInputElement;
      let fechaHoraLimite = '';
      if (fechaLimInput && fechaLimInput.value) {
        const horaVal = (horaLimInput && horaLimInput.value) ? horaLimInput.value : '23:59';
        fechaHoraLimite = `${fechaLimInput.value} ${horaVal}:00`;
      }

      const fd = new FormData();
      fd.append('observacion', tpNombre.value.trim());
      fd.append('tipo', 'tp');
      fd.append('curso_id', String(currentCursoId));
      fd.append('unidad_id', String(unidadId));
      fd.append('carpeta', `unidad-${unidadId}-tp`);
      if (fechaHoraLimite) {
        fd.append('fecha_limite', fechaHoraLimite);
      }
      fd.append('archivo', tpFile.files[0]);

      try {
        await api.material.subirMaterial(fd);
        cerrarModalCrearTP();
        await cargarContenidos(currentCursoId);
      } catch (err: any) {
        alert('Error al crear trabajo práctico: ' + err.message);
      }
    });

    // -----------------------------------------------------------------
    // CONSTRUCTOR INTERACTIVO DE EXÁMENES (Preguntas dinámicas)
    // -----------------------------------------------------------------
    interface PreguntaExamen {
      id: string;
      tipo: 'opcion_unica' | 'seleccion_multiple' | 'desarrollo';
      enunciado: string;
      puntos: number;
      opciones: string[];
      respuesta_correcta: string | string[];
    }

    let preguntasExamen: PreguntaExamen[] = [];

    const modalExamen = document.getElementById('modal-examen');
    const preguntasContainer = document.getElementById('preguntas-builder-container');
    const badgePreguntasCount = document.getElementById('badge-preguntas-count');
    const btnAgregarPregunta = document.getElementById('btn-agregar-pregunta');
    const inputExamenTitulo = document.getElementById('examen-titulo') as HTMLInputElement;
    const selectExamenUnidad = document.getElementById('examen-select-unidad') as HTMLSelectElement;
    const inputExamenFecha = document.getElementById('examen-fecha') as HTMLInputElement;
    const inputExamenHoraInicio = document.getElementById('examen-hora-inicio') as HTMLInputElement;
    const inputExamenHoraFin = document.getElementById('examen-hora-fin') as HTMLInputElement;
    const inputExamenDuracion = document.getElementById('examen-duracion') as HTMLInputElement;

    function renderPreguntasBuilder() {
      if (!preguntasContainer) return;

      if (badgePreguntasCount) {
        badgePreguntasCount.textContent = `${preguntasExamen.length} Pregunta(s)`;
      }

      if (preguntasExamen.length === 0) {
        preguntasContainer.innerHTML = `
          <div class="p-6 text-center rounded-2xl border border-dashed border-slate-200 bg-slate-50/50 space-y-2">
            <i class="fa-solid fa-circle-question text-2xl text-slate-300"></i>
            <p class="text-xs font-bold text-slate-600">Aún no has agregado preguntas a esta evaluación.</p>
            <p class="text-[11px] text-slate-400">Haz clic en "+ Agregar Pregunta" para incorporar opciones múltiples, selección múltiple o preguntas a desarrollar.</p>
          </div>
        `;
        return;
      }

      preguntasContainer.innerHTML = preguntasExamen.map((p, idx) => `
        <div class="border border-slate-200 rounded-2xl p-5 bg-white space-y-4 shadow-xs hover:border-blue-200 transition-colors" data-pregunta-id="${p.id}">
          <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-xs">
                ${idx + 1}
              </span>
              <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Pregunta N° ${idx + 1}</span>
            </div>

            <div class="flex items-center gap-3">
              <div class="flex items-center gap-1 text-xs">
                <span class="text-slate-500 font-semibold">Puntos:</span>
                <input type="number" min="1" max="100" value="${p.puntos}" class="input-puntos w-14 px-2 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs font-bold text-slate-800 text-center outline-none" data-idx="${idx}" />
              </div>
              <button type="button" class="btn-eliminar-p text-slate-400 hover:text-red-600 p-1 rounded-lg transition-colors cursor-pointer" data-idx="${idx}" title="Eliminar Pregunta">
                <i class="fa-solid fa-trash-can text-xs"></i>
              </button>
            </div>
          </div>

          <!-- Tipo de Pregunta y Enunciado -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <div>
              <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Tipo de Respuesta</label>
              <select class="select-tipo-p w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none font-bold text-slate-800" data-idx="${idx}">
                <option value="opcion_unica" ${p.tipo === 'opcion_unica' ? 'selected' : ''}>Opción Única (Multiple Choice)</option>
                <option value="seleccion_multiple" ${p.tipo === 'seleccion_multiple' ? 'selected' : ''}>Selección Múltiple (Casillas)</option>
                <option value="desarrollo" ${p.tipo === 'desarrollo' ? 'selected' : ''}>Respuesta Escrita (Desarrollo)</option>
              </select>
            </div>

            <div class="md:col-span-2">
              <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Enunciado / Consigna</label>
              <input type="text" value="${p.enunciado}" placeholder="Escriba aquí la pregunta para el alumno..." class="input-enunciado w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:bg-white focus:border-blue-600 font-semibold" data-idx="${idx}" required />
            </div>
          </div>

          <!-- Opciones para Opción Única o Selección Múltiple -->
          ${p.tipo !== 'desarrollo' ? `
            <div class="space-y-2.5 pt-2 border-t border-slate-100">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wider">
                  ${p.tipo === 'opcion_unica' ? 'Opciones (Marque la respuesta correcta)' : 'Opciones (Marque las respuestas válidas)'}
                </span>
                <button type="button" class="btn-agregar-opcion px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-[11px] rounded-lg transition-colors flex items-center gap-1 cursor-pointer" data-idx="${idx}">
                  <i class="fa-solid fa-plus text-[10px]"></i>
                  <span>+ Opción</span>
                </button>
              </div>

              <div class="space-y-2">
                ${p.opciones.map((opc, opcIdx) => {
                  const esCorrecta = p.tipo === 'opcion_unica'
                    ? p.respuesta_correcta === opc
                    : Array.isArray(p.respuesta_correcta) && p.respuesta_correcta.includes(opc);

                  return `
                    <div class="flex items-center gap-2">
                      <input 
                        type="${p.tipo === 'opcion_unica' ? 'radio' : 'checkbox'}" 
                        name="correcta_${p.id}" 
                        ${esCorrecta ? 'checked' : ''} 
                        class="check-correcta w-4 h-4 text-blue-600 focus:ring-blue-500 cursor-pointer shrink-0" 
                        data-p-idx="${idx}" 
                        data-opc-idx="${opcIdx}" 
                        title="Marcar como respuesta correcta"
                      />
                      <input 
                        type="text" 
                        value="${opc}" 
                        placeholder="Opción ${opcIdx + 1}..." 
                        class="input-opcion flex-1 px-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-xl outline-none focus:bg-white focus:border-blue-600 font-medium" 
                        data-p-idx="${idx}" 
                        data-opc-idx="${opcIdx}" 
                        required 
                      />
                      <button type="button" class="btn-eliminar-opcion text-slate-300 hover:text-red-500 p-1.5 rounded-lg transition-colors cursor-pointer shrink-0" data-p-idx="${idx}" data-opc-idx="${opcIdx}" title="Eliminar opción">
                        <i class="fa-solid fa-xmark text-xs"></i>
                      </button>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          ` : `
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80 text-[11px] text-slate-500 flex items-center gap-2">
              <i class="fa-solid fa-align-left text-blue-500"></i>
              <span>El alumno responderá con un campo de texto abierto/desarrollo que usted podrá calificar y retroalimentar.</span>
            </div>
          `}
        </div>
      `).join('');

      conectarEventosPreguntas();
    }

    function conectarEventosPreguntas() {
      // Cambio de tipo de pregunta
      document.querySelectorAll('.select-tipo-p').forEach((el) => {
        el.addEventListener('change', (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute('data-idx'));
          const nuevoTipo = (e.target as HTMLSelectElement).value as any;
          preguntasExamen[idx].tipo = nuevoTipo;
          if (nuevoTipo !== 'desarrollo' && preguntasExamen[idx].opciones.length === 0) {
            preguntasExamen[idx].opciones = ['Opción A', 'Opción B'];
            preguntasExamen[idx].respuesta_correcta = nuevoTipo === 'opcion_unica' ? 'Opción A' : ['Opción A'];
          }
          renderPreguntasBuilder();
        });
      });

      // Cambio de enunciado
      document.querySelectorAll('.input-enunciado').forEach((el) => {
        el.addEventListener('input', (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute('data-idx'));
          preguntasExamen[idx].enunciado = (e.target as HTMLInputElement).value;
        });
      });

      // Cambio de puntos
      document.querySelectorAll('.input-puntos').forEach((el) => {
        el.addEventListener('input', (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute('data-idx'));
          preguntasExamen[idx].puntos = Number((e.target as HTMLInputElement).value) || 1;
        });
      });

      // Eliminar pregunta
      document.querySelectorAll('.btn-eliminar-p').forEach((el) => {
        el.addEventListener('click', (e) => {
          const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-idx'));
          preguntasExamen.splice(idx, 1);
          renderPreguntasBuilder();
        });
      });

      // Agregar opción
      document.querySelectorAll('.btn-agregar-opcion').forEach((el) => {
        el.addEventListener('click', (e) => {
          const pIdx = Number((e.currentTarget as HTMLElement).getAttribute('data-idx'));
          const num = preguntasExamen[pIdx].opciones.length + 1;
          preguntasExamen[pIdx].opciones.push(`Nueva Opción ${num}`);
          renderPreguntasBuilder();
        });
      });

      // Cambio de texto de opción
      document.querySelectorAll('.input-opcion').forEach((el) => {
        el.addEventListener('input', (e) => {
          const pIdx = Number((e.target as HTMLElement).getAttribute('data-p-idx'));
          const opcIdx = Number((e.target as HTMLElement).getAttribute('data-opc-idx'));
          const prevVal = preguntasExamen[pIdx].opciones[opcIdx];
          const newVal = (e.target as HTMLInputElement).value;
          preguntasExamen[pIdx].opciones[opcIdx] = newVal;

          // Actualizar respuesta correcta si coincidía
          if (preguntasExamen[pIdx].tipo === 'opcion_unica') {
            if (preguntasExamen[pIdx].respuesta_correcta === prevVal) {
              preguntasExamen[pIdx].respuesta_correcta = newVal;
            }
          } else if (Array.isArray(preguntasExamen[pIdx].respuesta_correcta)) {
            preguntasExamen[pIdx].respuesta_correcta = (preguntasExamen[pIdx].respuesta_correcta as string[]).map(r => r === prevVal ? newVal : r);
          }
        });
      });

      // Eliminar opción
      document.querySelectorAll('.btn-eliminar-opcion').forEach((el) => {
        el.addEventListener('click', (e) => {
          const pIdx = Number((e.currentTarget as HTMLElement).getAttribute('data-p-idx'));
          const opcIdx = Number((e.currentTarget as HTMLElement).getAttribute('data-opc-idx'));
          if (preguntasExamen[pIdx].opciones.length <= 2) {
            alert('Debe conservar al menos 2 opciones en una pregunta de opción múltiple.');
            return;
          }
          const removed = preguntasExamen[pIdx].opciones.splice(opcIdx, 1)[0];
          if (preguntasExamen[pIdx].tipo === 'opcion_unica' && preguntasExamen[pIdx].respuesta_correcta === removed) {
            preguntasExamen[pIdx].respuesta_correcta = preguntasExamen[pIdx].opciones[0];
          }
          renderPreguntasBuilder();
        });
      });

      // Marcar correcta
      document.querySelectorAll('.check-correcta').forEach((el) => {
        el.addEventListener('change', (e) => {
          const pIdx = Number((e.target as HTMLElement).getAttribute('data-p-idx'));
          const opcIdx = Number((e.target as HTMLElement).getAttribute('data-opc-idx'));
          const opcion = preguntasExamen[pIdx].opciones[opcIdx];

          if (preguntasExamen[pIdx].tipo === 'opcion_unica') {
            preguntasExamen[pIdx].respuesta_correcta = opcion;
          } else {
            if (!Array.isArray(preguntasExamen[pIdx].respuesta_correcta)) {
              preguntasExamen[pIdx].respuesta_correcta = [];
            }
            const arr = preguntasExamen[pIdx].respuesta_correcta as string[];
            if ((e.target as HTMLInputElement).checked) {
              if (!arr.includes(opcion)) arr.push(opcion);
            } else {
              preguntasExamen[pIdx].respuesta_correcta = arr.filter(o => o !== opcion);
            }
          }
        });
      });
    }

    btnAgregarPregunta?.addEventListener('click', () => {
      const nuevaId = 'q_' + Date.now();
      preguntasExamen.push({
        id: nuevaId,
        tipo: 'opcion_unica',
        enunciado: '',
        puntos: 3,
        opciones: ['Opción 1', 'Opción 2', 'Opción 3'],
        respuesta_correcta: 'Opción 1'
      });
      renderPreguntasBuilder();
    });

    function abrirModalExamen(unidadId?: string | null, unidadNombre?: string) {
      if (unidadId && selectExamenUnidad) {
        selectExamenUnidad.value = unidadId;
      }
      if (inputExamenTitulo) {
        inputExamenTitulo.placeholder = unidadNombre ? `Evaluación: ${unidadNombre}` : 'Ej: Primer Parcial: Unidades 1 y 2';
      }
      if (inputExamenFecha && !inputExamenFecha.value) {
        inputExamenFecha.value = new Date().toISOString().split('T')[0];
      }
      if (inputExamenHoraInicio && !inputExamenHoraInicio.value) {
        inputExamenHoraInicio.value = '18:00';
      }
      if (inputExamenHoraFin && !inputExamenHoraFin.value) {
        inputExamenHoraFin.value = '20:00';
      }

      // Iniciar con 2 preguntas por defecto si está vacío
      if (preguntasExamen.length === 0) {
        preguntasExamen = [
          {
            id: 'q_' + Date.now() + '_1',
            tipo: 'opcion_unica',
            enunciado: '¿Cuál es la función principal de los elementos de protección en una instalación?',
            puntos: 3,
            opciones: ['Proteger a las personas y equipos de fallas', 'Aumentar la potencia del circuito', 'Reducir el consumo eléctrico'],
            respuesta_correcta: 'Proteger a las personas y equipos de fallas'
          },
          {
            id: 'q_' + Date.now() + '_2',
            tipo: 'seleccion_multiple',
            enunciado: 'Seleccione todas las medidas de seguridad obligatorias:',
            puntos: 3,
            opciones: ['Uso de Elementos de Protección Personal (EPP)', 'Verificación de ausencia de tensión', 'Trabajar con calzado conductor'],
            respuesta_correcta: ['Uso de Elementos de Protección Personal (EPP)', 'Verificación de ausencia de tensión']
          },
          {
            id: 'q_' + Date.now() + '_3',
            tipo: 'desarrollo',
            enunciado: 'Explique con sus palabras la diferencia entre corriente continua y alterna.',
            puntos: 4,
            opciones: [],
            respuesta_correcta: ''
          }
        ];
      }
      renderPreguntasBuilder();
      modalExamen?.classList.remove('hidden');
    }

    const cerrarExamenModal = () => modalExamen?.classList.add('hidden');
    document.getElementById('btn-cerrar-examen-modal')?.addEventListener('click', cerrarExamenModal);
    document.getElementById('btn-cancelar-examen')?.addEventListener('click', cerrarExamenModal);

    document.getElementById('form-crear-examen')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentCursoId) return;

      if (preguntasExamen.length === 0) {
        alert('Debe agregar al menos una pregunta a la evaluación.');
        return;
      }

      // Validar que todas las preguntas tengan enunciado
      for (let i = 0; i < preguntasExamen.length; i++) {
        if (!preguntasExamen[i].enunciado.trim()) {
          alert(`La pregunta N° ${i + 1} no tiene un enunciado definido.`);
          return;
        }
      }

      const duracion = Number(inputExamenDuracion.value) || 45;
      const unidadId = selectExamenUnidad.value ? Number(selectExamenUnidad.value) : null;
      const horaIni = inputExamenHoraInicio?.value || '18:00';
      const horaFin = inputExamenHoraFin?.value || '20:00';

      try {
        await api.examen.agregar({
          curso_id: currentCursoId,
          unidad_id: unidadId,
          descripcion: inputExamenTitulo.value.trim(),
          fecha: inputExamenFecha.value || new Date().toISOString().split('T')[0],
          hora_inicio: horaIni,
          hora_fin: horaFin,
          duracion_minutos: duracion,
          preguntas: preguntasExamen,
          estado: 'activo'
        });

        inputExamenTitulo.value = '';
        preguntasExamen = [];
        cerrarExamenModal();
        await cargarContenidos(currentCursoId);
      } catch (err: any) {
        alert('Error al crear evaluación: ' + err.message);
      }
    });

    // Inicializar
    inicializarCursos();
  </script>
</DashboardLayout>

