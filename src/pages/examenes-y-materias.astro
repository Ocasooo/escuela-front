        return;
      }

      const fd = new FormData();
      fd.append('observacion', docNombre.value.trim());
      fd.append('tipo', 'guia');
      fd.append('curso_id', String(currentCursoId));
      fd.append('unidad_id', String(unidadId));
      fd.append('carpeta', `unidad-${unidadId}-docs`);
      fd.append('archivo', docFile.files[0]);

      try {
        await api.material.subirMaterial(fd);
        cerrarModalDoc();
        await cargarContenidos(currentCursoId);
      } catch (err: any) {
        alert('Error al subir documento: ' + err.message);
      }
    });

    // -----------------------------------------------------------------
    // Modal Crear TP en Unidad con Dropzone Claro y Prominente
    // -----------------------------------------------------------------
    const modalCrearTP = document.getElementById('modal-crear-tp');
    const tpSelectUnidad = document.getElementById('tp-select-unidad') as HTMLSelectElement;
    const tpSubtitulo = document.getElementById('tp-subtitulo-unidad');
    const tpNombre = document.getElementById('tp-nombre') as HTMLInputElement;
    const tpFile = document.getElementById('tp-file') as HTMLInputElement;
    const tpDropzone = document.getElementById('tp-dropzone');
    const tpDropPrompt = document.getElementById('tp-dropzone-prompt');
    const tpFileSelected = document.getElementById('tp-file-selected');
    const tpFilename = document.getElementById('tp-filename');
    const tpFilesize = document.getElementById('tp-filesize');
    const btnRemoverTpFile = document.getElementById('btn-remover-tp-file');

    configurarDropzone(tpDropzone, tpFile, tpDropPrompt, tpFileSelected, tpFilename, tpFilesize, btnRemoverTpFile);

    function abrirModalCrearTP(unidadId?: string | null, unidadNombre?: string) {
      if (unidadId && tpSelectUnidad) {
        tpSelectUnidad.value = unidadId;
      }
      if (tpSubtitulo && unidadNombre) {
        tpSubtitulo.textContent = `Asignar a: ${unidadNombre}`;
      } else if (tpSubtitulo) {
        tpSubtitulo.textContent = 'Asignar trabajo práctico a la unidad';
      }
      if (tpNombre) tpNombre.value = '';
