    // -----------------------------------------------------------------
    // Modal Subir Documento a Unidad con Dropzone
    // -----------------------------------------------------------------
    const modalDoc = document.getElementById('modal-documento');
    const docSelectUnidad = document.getElementById('doc-select-unidad') as HTMLSelectElement;
    const docSubtitulo = document.getElementById('doc-subtitulo-unidad');
    const docNombre = document.getElementById('doc-nombre') as HTMLInputElement;
    const docFile = document.getElementById('doc-file') as HTMLInputElement;
    const docDropzone = document.getElementById('doc-dropzone');
    const docDropPrompt = document.getElementById('doc-dropzone-prompt');
    const docFileSelected = document.getElementById('doc-file-selected');
    const docFilename = document.getElementById('doc-filename');
    const docFilesize = document.getElementById('doc-filesize');
    const btnRemoverDocFile = document.getElementById('btn-remover-doc-file');

    function configurarDropzone(
      dropzone: HTMLElement | null,
      fileInput: HTMLInputElement | null,
      promptEl: HTMLElement | null,
      selectedEl: HTMLElement | null,
      nameEl: HTMLElement | null,
      sizeEl: HTMLElement | null,
      removerBtn: HTMLElement | null
    ) {
      if (!dropzone || !fileInput) return;

      dropzone.addEventListener('click', (e) => {
        if (e.target === removerBtn || (e.target as HTMLElement)?.closest('button') === removerBtn) return;
        fileInput.click();
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          const file = fileInput.files[0];
          if (nameEl) nameEl.textContent = file.name;
          if (sizeEl) {
            const kb = (file.size / 1024).toFixed(1);
            const mb = (file.size / (1024 * 1024)).toFixed(2);
            sizeEl.textContent = file.size > 1024 * 1024 ? `${mb} MB` : `${kb} KB`;
          }
          promptEl?.classList.add('hidden');
          selectedEl?.classList.remove('hidden');
        }
      });

      removerBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        fileInput.value = '';
        selectedEl?.classList.add('hidden');
        promptEl?.classList.remove('hidden');
      });

      // Drag & Drop
      dropzone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropzone.classList.add('border-blue-500', 'bg-blue-100/50');
      });
      dropzone.addEventListener('dragleave', () => {
        dropzone.classList.remove('border-blue-500', 'bg-blue-100/50');
      });
      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-blue-500', 'bg-blue-100/50');
        if (e.dataTransfer && e.dataTransfer.files.length > 0) {
          fileInput.files = e.dataTransfer.files;
          fileInput.dispatchEvent(new Event('change'));
        }
      });
    }

    configurarDropzone(docDropzone, docFile, docDropPrompt, docFileSelected, docFilename, docFilesize, btnRemoverDocFile);
    configurarDropzone(imgDropzone, imgFile, imgDropPrompt, imgFileSelected, imgFilename, imgFilesize, btnRemoverImgFile);

    function abrirModalDocumento(unidadId?: string | null, unidadNombre?: string) {
      if (unidadId && docSelectUnidad) {
        docSelectUnidad.value = unidadId;
      }
      if (docSubtitulo && unidadNombre) {
        docSubtitulo.textContent = `Asignar a: ${unidadNombre}`;
      } else if (docSubtitulo) {
        docSubtitulo.textContent = 'Asignar material didáctico a la unidad';
      }
      if (docNombre) docNombre.value = '';
      if (docFile) docFile.value = '';
      docFileSelected?.classList.add('hidden');
      docDropPrompt?.classList.remove('hidden');
      modalDoc?.classList.remove('hidden');
    }

    const cerrarModalDoc = () => modalDoc?.classList.add('hidden');
    document.getElementById('btn-cerrar-modal-doc')?.addEventListener('click', cerrarModalDoc);
    document.getElementById('btn-cancelar-doc')?.addEventListener('click', cerrarModalDoc);

    document.getElementById('form-subir-documento')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentCursoId) return;

      const unidadId = docSelectUnidad?.value;
      if (!unidadId) {
        alert('Debe seleccionar una unidad para este documento.');
        return;
      }

      if (!docFile.files || docFile.files.length === 0) {
