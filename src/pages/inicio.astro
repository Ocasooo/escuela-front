---
import MoodleLayout from '../layouts/Moodle-Layout.astro';
---

<MoodleLayout title="Mis Cursos">
  <div class="space-y-8">
    <!-- Banner de bienvenida -->
    <div class="bg-gradient-to-r from-blue-700 via-indigo-700 to-slate-900 rounded-3xl p-8 text-white shadow-xl relative overflow-hidden">
      <div class="relative z-10 max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-white/10 text-blue-200 backdrop-blur-md mb-3 border border-white/10">
          <i class="fa-solid fa-sparkles text-amber-300"></i>
          Ciclo Lectivo 2024
        </span>
        <h1 class="text-3xl font-extrabold tracking-tight">Bienvenido/a, <span id="student-greeting-name">Estudiante</span></h1>
        <p class="text-blue-100 text-sm mt-2 leading-relaxed">
          Accede al material de estudio, entrega tus trabajos prácticos y rinde tus exámenes en línea.
        </p>
      </div>
      <div class="absolute right-0 bottom-0 translate-x-8 translate-y-8 opacity-10 pointer-events-none text-white text-9xl">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
    </div>

    <!-- Banner de Cursos Aprobados / Graduación (Visible solo si tiene aprobados) -->
    <div id="banner-cursos-aprobados" class="hidden bg-gradient-to-r from-amber-500 via-amber-600 to-amber-700 rounded-3xl p-6 text-white shadow-lg flex flex-col sm:flex-row items-center justify-between gap-4 animate-fadeIn">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center text-3xl shrink-0 shadow-inner">
          <i class="fa-solid fa-award text-amber-100"></i>
        </div>
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-white/25 text-amber-100 mb-1">
            Certificaciones Disponibles
          </span>
          <h3 class="text-lg font-black leading-tight">¡Felicitaciones! Tienes cursos y especialidades aprobadas</h3>
          <p class="text-xs text-amber-100 mt-0.5">Ya puedes consultar tus calificaciones de egreso y descargar tus certificados oficiales con validez ministerial.</p>
        </div>
      </div>
      <a href="/cursos-aprobados" class="px-5 py-2.5 bg-white hover:bg-amber-50 text-amber-900 font-extrabold text-xs rounded-xl shadow-md transition-all shrink-0 flex items-center gap-2 cursor-pointer">
        <i class="fa-solid fa-graduation-cap text-amber-600"></i>
        <span>Ver Cursos Aprobados →</span>
      </a>
    </div>

    <!-- Banner de Cursos Desaprobados (Visible solo si tiene desaprobados) -->
    <div id="banner-cursos-desaprobados" class="hidden bg-gradient-to-r from-slate-900 via-rose-950 to-slate-900 rounded-3xl p-6 text-white shadow-lg flex flex-col sm:flex-row items-center justify-between gap-4 animate-fadeIn border border-rose-900/40">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-rose-500/20 border border-rose-400/30 backdrop-blur-md flex items-center justify-center text-3xl shrink-0 text-rose-400">
          <i class="fa-solid fa-circle-exclamation"></i>
        </div>
        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-rose-500/25 text-rose-300 mb-1 border border-rose-500/30">
            Seguimiento Académico
          </span>
          <h3 class="text-lg font-black leading-tight">Tienes materias pendientes de acreditación o examen recuperatorio</h3>
          <p class="text-xs text-slate-300 mt-0.5">Accede para consultar los contenidos, fechas y foros de consulta con tus profesores.</p>
        </div>
      </div>
      <a href="/cursos-desaprobados" class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-extrabold text-xs rounded-xl shadow-md transition-all shrink-0 flex items-center gap-2 cursor-pointer">
        <i class="fa-solid fa-circle-xmark text-rose-200"></i>
        <span>Ver Cursos Desaprobados →</span>
      </a>
    </div>

    <!-- Catálogo de Cursos Inscriptos -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-black text-slate-900">Mis Cursos y Materias</h2>
          <p class="text-xs text-slate-500">Haz clic en un curso para ingresar al aula virtual</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-500 bg-slate-200/70 px-3 py-1.5 rounded-xl" id="courses-counter">
            Cargando cursos...
          </span>
        </div>
      </div>

      <div id="courses-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Tarjetas dinámicas generadas por JS -->
      </div>
    </div>
  </div>

  <script>
    import { api } from '../lib/api';
    import { getCurrentUser } from '../lib/auth';

    const user = getCurrentUser();
    if (user) {
      const greetingEl = document.getElementById('student-greeting-name');
      if (greetingEl) greetingEl.textContent = `${user.nombre} ${user.apellido}`;
    }

    async function cargarCursos() {
      const grid = document.getElementById('courses-grid');
      const counter = document.getElementById('courses-counter');
      if (!grid) return;

      try {
        let cursos: any[] = [];
        if (user?.id) {
          const rol = (user.ocupacion || '').toLowerCase();
          if (rol === 'profesor' || rol === 'docente' || rol === 'administrador' || rol === 'admin') {
            // El profesor o administrador solo ve aquellos cursos donde está registrado
            cursos = await api.curso.cursosPorPersonal(user.id);
          } else {
            // Alumnos ven los cursos donde están matriculados
            cursos = await api.curso.cursosPorAlumno(user.id);

            // Si el alumno tiene cursos aprobados/egresados, mostrar banner de felicitación
            api.curso.cursosAprobadosPorAlumno(user.id).then((aprobados) => {
              if (aprobados && Array.isArray(aprobados) && aprobados.length > 0) {
                document.getElementById('banner-cursos-aprobados')?.classList.remove('hidden');
              }
            }).catch(() => null);

            // Si el alumno tiene cursos desaprobados, mostrar banner informativo
            api.curso.cursosDesaprobadosPorAlumno(user.id).then((desaprobados) => {
              if (desaprobados && Array.isArray(desaprobados) && desaprobados.length > 0) {
                document.getElementById('banner-cursos-desaprobados')?.classList.remove('hidden');
              }
            }).catch(() => null);
          }
        }

        if (!cursos || cursos.length === 0) {
          if (counter) counter.textContent = '0 cursos activos';
          const esDocenteOAdmin = user && ['profesor', 'docente', 'administrador', 'admin'].includes((user.ocupacion || '').toLowerCase());
          grid.innerHTML = `
            <div class="col-span-full p-12 text-center text-slate-400 bg-white rounded-3xl border border-slate-200">
              <i class="fa-solid fa-book-open text-3xl text-slate-300 mb-3 block"></i>
              <p class="font-bold text-slate-600">${esDocenteOAdmin ? 'No tienes cursos asignados a tu cargo actualmente.' : 'No tienes cursos inscriptos actualmente.'}</p>
              <p class="text-xs text-slate-400 mt-1">${esDocenteOAdmin ? 'Comunícate con Dirección/Administración para que se te asigne la titularidad de un curso.' : 'Comunícate con Secretaría para matricularte a un trayecto formativo.'}</p>
            </div>
          `;
          return;
        }

        if (counter) counter.textContent = `${cursos.length} curso(s) activo(s)`;

        grid.innerHTML = cursos.map((c) => `
          <a href="/curso-detalle?id=${c.id}" class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col group cursor-pointer block text-inherit no-underline">
            <div class="h-32 bg-gradient-to-r ${c.color || 'from-blue-600 to-indigo-700'} p-6 flex flex-col justify-between relative overflow-hidden">
              <div class="flex justify-between items-start relative z-10">
                <span class="px-2.5 py-1 rounded-full bg-white/20 text-white text-[11px] font-bold backdrop-blur-md">
                  Curso Regular
                </span>
                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-white text-sm">
                  <i class="fa-solid fa-book"></i>
                </div>
              </div>
              <h3 class="text-white font-bold text-lg leading-snug drop-shadow-sm relative z-10 truncate">${c.nombre}</h3>
            </div>
            
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <p class="text-xs text-slate-500 line-clamp-2">${c.descripcion || 'Materia curricular de formación profesional.'}</p>
              
              <div class="space-y-2">
                <div class="flex justify-between text-xs font-semibold text-slate-600">
                  <span>Progreso del Curso</span>
                  <span class="text-blue-600">${c.progreso || 50}%</span>
                </div>
                <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                  <div class="h-full bg-blue-600 rounded-full transition-all duration-500" style="width: ${c.progreso || 50}%"></div>
                </div>
              </div>

              <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center space-x-2 text-xs text-slate-500">
                  <i class="fa-solid fa-user-tie text-slate-400"></i>
                  <span class="truncate max-w-[140px]">${c.profesor || 'Docente a cargo'}</span>
                </div>
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-blue-600 group-hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition-all shadow-md shadow-blue-500/20">
                  <span>Entrar</span>
                  <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                </span>
              </div>
            </div>
          </a>
        `).join('');

      } catch (err) {
        console.error('Error al cargar cursos:', err);
        grid.innerHTML = `<div class="col-span-full p-8 text-center text-slate-400">No se pudieron cargar los cursos en este momento.</div>`;
      }
    }

    cargarCursos();
  </script>
</MoodleLayout>