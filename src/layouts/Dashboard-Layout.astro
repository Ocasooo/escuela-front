---
import '../css/style.css';
import DemoBanner from '../components/DemoBanner.astro';
interface Props {
  title: string;
  path: string;
  pageTitle: string;
}

const { title, path, pageTitle } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/aef010b255.js" is:inline crossorigin="anonymous"></script>
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Panel Docente/Admin - EFP N°31</title>
  </head>
  <body class="bg-slate-100 text-slate-700 min-h-screen flex font-sans antialiased overflow-x-hidden">
    <!-- Overlay móvil -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden backdrop-blur-sm transition-opacity"></div>

    <!-- Sidenav -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-slate-900 text-white flex flex-col transition-transform duration-300 -translate-x-full lg:translate-x-0 shadow-2xl">
      <!-- Sidebar Header -->
      <div class="h-20 flex items-center justify-between px-6 border-b border-slate-800">
        <a href="/inicio-dashboard" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg group-hover:bg-blue-500 transition-colors">
            <i class="fa-solid fa-chalkboard-user text-lg"></i>
          </div>
          <div>
            <h1 class="font-bold text-sm leading-tight text-white">EFP N° 31</h1>
            <p class="text-[11px] text-blue-400 font-semibold tracking-wide uppercase" id="sidebar-role-badge">Panel de Gestión</p>
          </div>
        </a>
        <button id="sidebar-close-btn" class="lg:hidden text-slate-400 hover:text-white p-1">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <!-- Navigation Links -->
      <div class="flex-1 overflow-y-auto py-4 px-4 space-y-6 sidebar-custom">
        <!-- Inicio -->
        <div>
          <a href="/inicio-dashboard" id="nav-inicio" class="flex items-center px-4 py-3 rounded-xl text-sm font-semibold text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
            <i class="fa-solid fa-house w-6 text-slate-400"></i>
            <span>Resumen Dashboard</span>
          </a>
        </div>

        <!-- SECCIÓN: DOCENCIA Y CORRECCIÓN (Visible para Docente y Admin) -->
        <div id="section-docencia">
          <h6 class="px-4 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
            <span id="docencia-header-title">Docencia y Cursos</span>
            <span class="text-[10px] bg-blue-900/60 text-blue-300 px-2 py-0.5 rounded-full">Docente</span>
          </h6>
          <div class="space-y-1">
            <a href="/practicos" id="nav-practicos" class="flex items-center px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
              <i class="fa-solid fa-file-pen w-6 text-amber-400"></i>
              <span>Corregir Prácticos</span>
            </a>
            <a href="/examenes-y-materias" id="nav-examenes" class="flex items-center px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
              <i class="fa-solid fa-layer-group w-6 text-blue-400"></i>
              <span>Contenido del Curso</span>
            </a>
            <a href="/desempeno" id="nav-desempeno" class="flex items-center px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
              <i class="fa-solid fa-chart-simple w-6 text-emerald-400"></i>
              <span>Notas de Cursado</span>
            </a>
          </div>
        </div>

        <!-- SECCIÓN: GESTIÓN INSTITUCIONAL (Solo Administrador) -->
        <div id="section-admin" class="hidden">
          <h6 class="px-4 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
            <span>Gestión Institucional</span>
            <span class="text-[10px] bg-purple-900/60 text-purple-300 px-2 py-0.5 rounded-full">Admin</span>
          </h6>
          <div class="space-y-1">
            <a href="/gestion-de-usuarios" id="nav-usuarios" class="flex items-center px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
              <i class="fa-solid fa-users-gear w-6 text-purple-400"></i>
              <span>Gestión de Usuarios</span>
            </a>
            <a href="/administrar-cursos" id="nav-cursos" class="flex items-center px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
              <i class="fa-solid fa-graduation-cap w-6 text-indigo-400"></i>
              <span>Administrar Cursos</span>
            </a>
            <a href="/inscripcion-de-estudiantes" id="nav-inscripciones" class="flex items-center px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
              <i class="fa-solid fa-user-plus w-6 text-cyan-400"></i>
              <span>Inscripciones</span>
            </a>
            <a href="/aulas-y-horarios" id="nav-aulas" class="flex items-center px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
              <i class="fa-solid fa-calendar-days w-6 text-teal-400"></i>
              <span>Aulas y Horarios</span>
            </a>
            <a href="/titulacion" id="nav-titulacion" class="flex items-center px-4 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition-colors">
              <i class="fa-solid fa-award w-6 text-amber-300"></i>
              <span>Titulación y Diplomas</span>
            </a>
          </div>
        </div>
      </div>

      <!-- User card bottom: Enlace completo a Mi Perfil sin tuerca y con efecto hover -->
      <a href="/perfil" class="p-4 border-t border-slate-800 bg-slate-950/40 hover:bg-slate-800/80 transition-all flex items-center space-x-3 group cursor-pointer block" title="Mi Perfil">
        <div class="flex items-center space-x-3 overflow-hidden w-full">
          <div class="w-10 h-10 rounded-full bg-blue-600 group-hover:bg-blue-500 flex items-center justify-center font-bold text-white text-sm shrink-0 transition-colors shadow-md" id="sidebar-user-initials">
            U
          </div>
          <div class="overflow-hidden flex-1">
            <p class="text-sm font-bold text-white truncate group-hover:text-blue-300 transition-colors" id="sidebar-user-name">Usuario</p>
            <p class="text-xs text-blue-400 capitalize truncate" id="sidebar-user-role">Docente</p>
          </div>
        </div>
      </a>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col lg:pl-72 min-w-0">
      <!-- Banner Modo Demo -->
      <DemoBanner />

      <!-- Topbar -->
      <header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 sticky top-0 z-30 shadow-sm">
        <div class="flex items-center space-x-4">
          <button id="sidebar-open-btn" class="lg:hidden text-slate-600 hover:text-slate-900 p-2 rounded-lg hover:bg-slate-100">
            <i class="fa-solid fa-bars text-lg"></i>
          </button>
          <div>
            <nav class="flex items-center space-x-2 text-xs text-slate-500 font-medium">
              <a href="/inicio-dashboard" class="hover:text-blue-600">Dashboard</a>
              <span>/</span>
              <span class="text-slate-800 font-bold capitalize">{path}</span>
            </nav>
            <h2 class="text-base font-bold text-slate-900 leading-tight">{pageTitle}</h2>
          </div>
        </div>

        <div class="flex items-center space-x-4">
          <a href="/inicio" class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors" title="Ver como Alumno">
            <i class="fa-solid fa-laptop text-slate-500"></i>
            <span>Vista Aula Moodle</span>
          </a>

          <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>

          <button id="topbar-logout-btn" class="p-2 text-red-600 hover:bg-red-50 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer" title="Cerrar sesión">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
            <span class="hidden sm:inline">Salir</span>
          </button>
        </div>
      </header>

      <!-- Page Content -->
      <main class="flex-1 p-6 md:p-8 max-w-7xl w-full mx-auto">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="bg-white border-t border-slate-200 py-4 px-6 text-center text-xs text-slate-400">
        <p>© 2024 Escuela de Formación Profesional N° 31 - Sistema de Gestión Académica</p>
      </footer>
    </div>

    <!-- Scripts de interactividad y autenticación -->
    <script>
      import { getCurrentUser, clearSession, isAuthenticated, normalizarRol } from '../lib/auth';

      // 1. Verificar autenticación
      if (!isAuthenticated()) {
        window.location.href = '/';
      }

      const user = getCurrentUser();
      const rol = normalizarRol(user?.ocupacion);

      // Si es alumno, no debe estar en el dashboard de profesores/admin
      if (rol === 'alumno') {
        alert('Esta sección es exclusiva para el personal docente y administrativo.');
        window.location.href = '/inicio';
      }

      // 2. Poblar datos del usuario
      if (user) {
        const fullName = `${user.nombre} ${user.apellido}`;
        const initials = (user.nombre[0] || 'U') + (user.apellido[0] || '');

        const sidebarName = document.getElementById('sidebar-user-name');
        const sidebarRole = document.getElementById('sidebar-user-role');
        const sidebarInitials = document.getElementById('sidebar-user-initials');
        const topbarName = document.getElementById('topbar-user-name');
        const roleBadge = document.getElementById('sidebar-role-badge');

        if (sidebarName) sidebarName.textContent = fullName;
        if (sidebarRole) sidebarRole.textContent = user.ocupacion || 'Docente';
        if (sidebarInitials) sidebarInitials.textContent = initials;
        if (topbarName) topbarName.textContent = fullName;
        if (roleBadge) roleBadge.textContent = rol === 'administrador' ? 'Admin + Docente' : 'Docente';

        // 3. Reglas de visibilidad de roles (DUAL ROLE)
        const sectionAdmin = document.getElementById('section-admin');
        const docenciaTitle = document.getElementById('docencia-header-title');

        if (rol === 'administrador') {
          // Mostrar tanto sección institucional como sección de docencia
          sectionAdmin?.classList.remove('hidden');
          if (docenciaTitle) docenciaTitle.textContent = 'Mis Cursos y Docencia';
        } else {
          // Profesor solo ve docencia
          sectionAdmin?.classList.add('hidden');
          if (docenciaTitle) docenciaTitle.textContent = 'Docencia y Corrección';
        }
      }

      // 4. Highlight current active nav item
      const currentPath = window.location.pathname.split('/').pop() || 'inicio-dashboard';
      const navMap: Record<string, string> = {
        'inicio-dashboard': 'nav-inicio',
        'practicos': 'nav-practicos',
        'examenes-y-materias': 'nav-examenes',
        'desempeno': 'nav-desempeno',
        'gestion-de-usuarios': 'nav-usuarios',
        'administrar-cursos': 'nav-cursos',
        'inscripcion-de-estudiantes': 'nav-inscripciones',
        'aulas-y-horarios': 'nav-aulas',
        'titulacion': 'nav-titulacion'
      };

      const activeNavId = navMap[currentPath];
      if (activeNavId) {
        const activeEl = document.getElementById(activeNavId);
        if (activeEl) {
          activeEl.classList.remove('text-slate-300', 'hover:bg-slate-800');
          activeEl.classList.add('bg-blue-600', 'text-white', 'font-bold', 'shadow-md');
          const icon = activeEl.querySelector('i');
          if (icon) icon.className = icon.className.replace(/text-[a-z]+-400/, 'text-white');
        }
      }

      // 5. Toggle sidebar móvil
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const openBtn = document.getElementById('sidebar-open-btn');
      const closeBtn = document.getElementById('sidebar-close-btn');

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        backdrop?.classList.remove('hidden');
      }

      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        backdrop?.classList.add('hidden');
      }

      openBtn?.addEventListener('click', openSidebar);
      closeBtn?.addEventListener('click', closeSidebar);
      backdrop?.addEventListener('click', closeSidebar);

      // 6. Logout
      document.getElementById('topbar-logout-btn')?.addEventListener('click', () => {
        clearSession();
        window.location.href = '/';
      });
    </script>
  </body>
</html>