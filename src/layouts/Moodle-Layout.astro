---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../css/style.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Aula Virtual EFP N°31" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/aef010b255.js" is:inline crossorigin="anonymous"></script>
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Aula Virtual EFP N°31</title>
  </head>
  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">
    <!-- Navbar -->
    <header class="bg-slate-900 text-white shadow-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <a href="/inicio" class="flex items-center space-x-3 group">
            <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center font-bold text-white shadow-md group-hover:bg-blue-500 transition-colors">
              <i class="fa-solid fa-graduation-cap text-lg"></i>
            </div>
            <div>
              <span class="text-base font-bold tracking-tight text-white block">EFP N° 31</span>
              <span class="text-xs text-slate-400 font-medium block">Aula Virtual Moodle</span>
            </div>
          </a>
        </div>


        <!-- Header Right: Botón Volver al Dashboard y Menú de Usuario -->
        <div class="flex items-center space-x-4">
          <!-- Botón Volver al Dashboard (solo visible para Docente o Administrador) -->
          <div id="header-admin-docente-btn" class="hidden">
            <a href="/inicio-dashboard" class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-bold text-slate-200 bg-slate-800 hover:bg-slate-700 hover:text-white rounded-xl transition-all border border-slate-700 shadow-xs" title="Volver al Panel de Gestión y Docencia">
              <i class="fa-solid fa-gauge-high text-amber-400"></i>
              <span>Volver al Dashboard</span>
            </a>
          </div>

          <!-- User Dropdown -->
          <div class="relative" id="user-menu-container">
            <button id="userMenuBtn" class="flex items-center space-x-3 p-1.5 rounded-full hover:bg-slate-800 focus:outline-none transition-colors cursor-pointer">
              <div class="w-9 h-9 rounded-full bg-blue-500 text-white font-bold flex items-center justify-center overflow-hidden border-2 border-blue-400" id="nav-user-avatar">
                <span id="nav-user-initials">U</span>
              </div>
              <div class="hidden sm:block text-left pr-2">
                <span class="block text-xs font-semibold text-white" id="nav-user-name">Cargando...</span>
                <span class="block text-[10px] text-blue-400 uppercase font-bold tracking-wider" id="nav-user-role">Alumno</span>
              </div>
              <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
            </button>

            <div id="userDropdown" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 text-slate-700 z-50 animate-fadeIn">
              <div class="px-4 py-2 border-b border-slate-100">
                <p class="text-xs text-slate-400">Conectado como</p>
                <p class="text-sm font-bold text-slate-900 truncate" id="dropdown-user-email">usuario@escuela.edu.ar</p>
              </div>
              <a href="/cursos-aprobados" id="dropdown-link-cursos-aprobados" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-amber-50 hover:text-amber-800 transition-colors font-medium">
                <i class="fa-solid fa-award w-5 text-amber-500"></i>
                <span>Cursos Aprobados</span>
              </a>
              <a href="/cursos-desaprobados" id="dropdown-link-cursos-desaprobados" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-rose-50 hover:text-rose-800 transition-colors font-medium">
                <i class="fa-solid fa-circle-xmark w-5 text-rose-500"></i>
                <span>Cursos Desaprobados</span>
              </a>
              <a href="/perfil" class="flex items-center px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition-colors">
                <i class="fa-solid fa-id-badge w-5 text-slate-400"></i>
                <span>Editar Mi Perfil</span>
              </a>
              <div class="border-t border-slate-100 my-1"></div>
              <button id="btnLogout" class="w-full text-left flex items-center px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors cursor-pointer">
                <i class="fa-solid fa-arrow-right-from-bracket w-5 text-red-400"></i>
                <span>Cerrar sesión</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-6 text-center text-xs text-slate-400">
      <p>© 2024 Escuela de Formación Profesional N° 31 - Plataforma Educativa</p>
    </footer>

    <!-- Script de autenticación y dropdown -->
    <script>
      import { getCurrentUser, clearSession, isAuthenticated } from '../lib/auth';

      // Verificar autenticación
      if (!isAuthenticated()) {
        window.location.href = '/';
      }

      const user = getCurrentUser();
      if (user) {
        const nameEl = document.getElementById('nav-user-name');
        const roleEl = document.getElementById('nav-user-role');
        const emailEl = document.getElementById('dropdown-user-email');
        const initialsEl = document.getElementById('nav-user-initials');
        const headerAdminDocenteBtn = document.getElementById('header-admin-docente-btn');

        if (nameEl) nameEl.textContent = `${user.nombre} ${user.apellido}`;
        if (roleEl) roleEl.textContent = user.ocupacion || 'Alumno';
        if (emailEl) emailEl.textContent = user.correo;
        if (initialsEl) initialsEl.textContent = (user.nombre[0] || 'U') + (user.apellido[0] || '');

        const rol = (user.ocupacion || '').toLowerCase().trim();
        if (['administrador', 'admin', 'profesor', 'docente'].includes(rol)) {
          headerAdminDocenteBtn?.classList.remove('hidden');
        }

        // Resaltar opción activa en dropdown
        const currentPath = window.location.pathname;
        if (currentPath.includes('/cursos-aprobados')) {
          document.getElementById('dropdown-link-cursos-aprobados')?.classList.add('bg-amber-50', 'text-amber-800', 'font-bold');
        } else if (currentPath.includes('/cursos-desaprobados')) {
          document.getElementById('dropdown-link-cursos-desaprobados')?.classList.add('bg-rose-50', 'text-rose-800', 'font-bold');
        }
      }

      // Dropdown toggle
      const userBtn = document.getElementById('userMenuBtn');
      const userDropdown = document.getElementById('userDropdown');

      userBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        userDropdown?.classList.toggle('hidden');
      });

      document.addEventListener('click', () => {
        userDropdown?.classList.add('hidden');
      });

      // Logout
      document.getElementById('btnLogout')?.addEventListener('click', () => {
        clearSession();
        window.location.href = '/';
      });
    </script>
  </body>
</html>